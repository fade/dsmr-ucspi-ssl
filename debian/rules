#!/usr/bin/make -f

# DSMR-focused info manual + HTML page, derived from the org source of truth
# (doc/ucspi-ssl.org) at build time.  Generators are Build-Depends only.
EMACS ?= emacs
TOPIC = doc/ucspi-ssl

%:
	dh $@

override_dh_auto_configure:
	# conf-home is patched to /usr by debian-install-paths.patch
	# package/compile creates the compile/ shadow tree and runs make
	package/compile base

override_dh_auto_build:
	# Build is done by package/compile in the configure step.
	# Generate the GNU info manual and HTML doc page from org.
	$(EMACS) --batch -Q \
	    --eval "(require 'ox-texinfo)" \
	    --eval "(with-current-buffer (find-file-noselect \"$(TOPIC).org\") (org-texinfo-export-to-texinfo))"
	makeinfo --no-split "$(TOPIC).texi" -o "$(TOPIC).info"
	$(EMACS) --batch -Q \
	    --eval "(require 'ox-html)" \
	    --eval "(setq org-html-validation-link nil)" \
	    --eval "(with-current-buffer (find-file-noselect \"$(TOPIC).org\") (org-html-export-to-html))"

override_dh_auto_install:
	install -d debian/ucspi-ssl/usr/bin
	for cmd in `cat package/commands-base`; do \
	  install -m 0755 command/$$cmd debian/ucspi-ssl/usr/bin/$$cmd || exit 1; \
	done
	for f in man/*.1 man/*.2; do \
	  [ -f "$$f" ] || continue; \
	  sect=$${f##*.}; \
	  install -d debian/ucspi-ssl/usr/share/man/man$$sect; \
	  install -m 0644 $$f debian/ucspi-ssl/usr/share/man/man$$sect/; \
	done

override_dh_auto_clean:
	rm -rf compile command
	rm -f "$(TOPIC).texi" "$(TOPIC).info" "$(TOPIC).html"
